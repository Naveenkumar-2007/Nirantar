# Dashboard (server-side only; never exposed to the browser)
NIRANTAR_API_URL=http://localhost:18080
NIRANTAR_MCP_URL=http://localhost:18100
# Sign-in (OIDC). Leave NIRANTAR_OIDC_ISSUER empty for local key mode (no sign-in; never on the internet).
NIRANTAR_OIDC_ISSUER=http://localhost:18180/realms/nirantar
NIRANTAR_OIDC_CLIENT_ID=nirantar-dashboard
NIRANTAR_OIDC_CLIENT_SECRET=
NIRANTAR_APP_URL=http://localhost:3010
# 32 random bytes, base64url: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
NIRANTAR_SESSION_SECRET=
# Local key mode only
NIRANTAR_API_KEY=
NIRANTAR_APPROVER_KEY=
NIRANTAR_PLATFORM_KEY=
