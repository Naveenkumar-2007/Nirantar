NIRANTAR_ENV=local

# Infrastructure (docker compose defaults)
DATABASE_URL=postgresql+psycopg://nirantar_app:nirantar_app@localhost:25432/nirantar
DATABASE_OWNER_URL=postgresql+psycopg://nirantar_owner:nirantar_owner@localhost:25432/nirantar
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:19092
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=nirantar
S3_SECRET_KEY=nirantar-secret
MLFLOW_TRACKING_URI=http://localhost:5000

# Security
APPROVAL_SIGNING_KEY=change-me-32-bytes-min
JWT_SIGNING_KEY=change-me-32-bytes-min

# LLM providers (at least one)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Voice
SARVAM_API_KEY=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Payment providers (test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Messaging — WhatsApp Cloud API (P6). Use a PERMANENT System User token (expiry: never).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-random
WHATSAPP_TEST_RECIPIENT=

# Dagster instance directory (absolute path); put `telemetry: {enabled: false}` in its dagster.yaml
DAGSTER_HOME=/absolute/path/to/nirantar/.dagster
# Lakehouse (defaults match docker-compose)
NIRANTAR_LAKE_CATALOG_URI=postgresql+psycopg://nirantar_owner:nirantar_owner@localhost:25432/nirantar_lake
NIRANTAR_LAKE_WAREHOUSE=s3://nirantar-lake/warehouse
NIRANTAR_S3_ENDPOINT=http://localhost:8333

# Platform operators
PLATFORM_ADMIN_KEY=change-me
API_KEY_PEPPER=change-me-at-least-16-chars

# Identity (P8): Keycloak OIDC — generate random secrets; docker compose reads them from this file
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
NIRANTAR_DASHBOARD_URL=http://localhost:3010
NIRANTAR_DASHBOARD_CLIENT_SECRET=change-me-random-32
NIRANTAR_OIDC_ISSUER=http://localhost:18180/realms/nirantar
NIRANTAR_OIDC_AUDIENCE=nirantar-api
# local automated tests only (password grant); keep false anywhere else
NIRANTAR_E2E_CLIENT_ENABLED=false
NIRANTAR_E2E_CLIENT_SECRET=
NIRANTAR_E2E_USER=
NIRANTAR_E2E_USER_PASSWORD=

# Public URLs (MCP server / A2A)
NIRANTAR_MCP_URL=http://localhost:18100
NIRANTAR_PUBLIC_URL=http://localhost:18080
