# Nirantar Python image: API, always-on services (workers, relay, bridge) and migrations — one image, three commands.
# Built from the locked dependency set (uv.lock); runs as a non-root user.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --all-extras --no-install-project
COPY src ./src
COPY alembic.ini ./
COPY ml ./ml
RUN uv sync --frozen --no-dev --all-extras

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 nirantar
WORKDIR /app
COPY --from=build --chown=nirantar:nirantar /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 NIRANTAR_ENV=production
USER nirantar
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -fsS http://localhost:8000/health || exit 1
CMD ["uvicorn", "nirantar.api.serve:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
