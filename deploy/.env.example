# Copy to deploy/.env on the server and fill every value. Never commit deploy/.env.
# Generate secrets with:  openssl rand -base64 32   (DATA_KEYS format: see docs/runbooks)

# ---- domain + TLS
NIRANTAR_DOMAIN=app.example.in          # the app; sign-in is served at auth.<this domain>
ACME_EMAIL=founder@example.in

# ---- databases and stores
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- sign-in (Keycloak) and dashboard sessions
KEYCLOAK_ADMIN_PASSWORD=
NIRANTAR_DASHBOARD_CLIENT_SECRET=
NIRANTAR_SESSION_SECRET=

# ---- Nirantar's own keys (rotate by adding a new key id to DATA_KEYS)
DATA_KEYS=
API_KEY_PEPPER=
APPROVAL_SIGNING_KEY=
PLATFORM_ADMIN_KEY=

# ---- providers (businesses connect their OWN Razorpay keys in the app; these are optional platform defaults)
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SARVAM_API_KEY=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=            # your ExoPhone
EXOTEL_FLOW_ID=              # the App whose Voicebot applet streams to wss://<domain>/voice/exotel
GROQ_API_KEY=
